# Скопируйте в .env и подставьте свои значения:  cp .env.example .env

# Приложение
APP_PORT=8080
API_PORT=8080
LOG_LEVEL=info

# База данных
DB_USER=bank
DB_PASSWORD=bank
DB_NAME=bank
DB_EXPOSED_PORT=5432

# Безопасность (обязательно изменить перед продуктивным использованием!)
JWT_SECRET=super-secret-jwt-key-change-me
HMAC_SECRET=super-secret-hmac-key-change-me
PGP_PASSPHRASE=super-secret-pgp-passphrase

# SMTP (по умолчанию — контейнер MailHog)
SMTP_ENABLED=true
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@bank.local

# Кредиты и шедулер
SCHEDULER_INTERVAL_HOURS=12
BANK_MARGIN=5
FALLBACK_KEY_RATE=16
PENALTY_RATE=0.10
MAX_PREDICT_DAYS=365
